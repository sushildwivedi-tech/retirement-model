{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "retirement-model",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "static-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "apps/web/out",
        "-l",
        "4000",
        "--no-clipboard"
      ],
      "port": 4000
    }
  ]
}